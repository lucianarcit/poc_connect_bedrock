# Variáveis de ambiente para execução local
# Copie para .env e preencha os valores

# AWS
AWS_REGION=us-east-1

# Amazon Connect
CONNECT_INSTANCE_ID=
CONNECT_INSTANCE_ARN=
CONNECT_CONTACT_FLOW_ID=

# SNS
SNS_TOPIC_ARN=

# DynamoDB
SESSIONS_TABLE_NAME=connect-mcp-poc-sessions
IDEMPOTENCY_TABLE_NAME=connect-mcp-poc-idempotency

# KMS
KMS_KEY_ARN=

# MCP Server
MCP_SERVER_URL=http://localhost:8000/mcp
MCP_TIMEOUT_SECONDS=10
MCP_MAX_RETRIES=2
